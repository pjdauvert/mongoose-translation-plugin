{
  "assist": {
    "actions": { "source": { "organizeImports": "on" } },
    "includes": ["**", "!**/dist/**/*", "!**/coverage/**/*"]
  },

  "formatter": {
    "includes": ["**", "!**/dist/**/*", "!**/.pnpm-store/**/*", "!**/coverage/**/*", "!**/package.json"],
    "enabled": true,
    "indentWidth": 2,
    "lineWidth": 160,
    "indentStyle": "space"
  },

  "javascript": {
    "formatter": {
      "enabled": true,
      "quoteStyle": "single",
      "trailingCommas": "none"
    }
  },

  "json": {
    "parser": {
      "allowComments": true
    }
  },

  "linter": {
    "includes": ["**", "!**/dist/**/*", "!**/coverage/**/*"],
    "enabled": true,
    "rules": { "recommended": true }
  }
}
